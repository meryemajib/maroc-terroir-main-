# Nabta Market — frontend environment
#
# Point the React app at your local Spring Boot backend.
# When unset, the app runs on the built-in local mock data/localStorage
# so it works with no backend (e.g. inside the Lovable preview).
#
# Copy this file to `.env` and adjust the URL to match your running backend.
VITE_API_URL=http://localhost:8080
